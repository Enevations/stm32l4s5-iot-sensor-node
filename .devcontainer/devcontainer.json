{
   "name": "STM32 Development Container",
   "build": {
      "dockerfile": "Dockerfile",
      "context": ".."
   },
   "mounts": [
    "source=stm32l4s5-deps-cache,target=${containerWorkspaceFolder}/.cache,type=volume",
    "source=stm32l4s5-build-cache,target=${containerWorkspaceFolder}/build,type=volume"
  ],
  "postCreateCommand": "chown -R root:root ${containerWorkspaceFolder}/.cache ${containerWorkspaceFolder}/build && git config core.hooksPath githooks",
   "customizations": {
      "vscode": {
         "extensions": [
            "mcu-debug.debug-tracker-vscode",
            "marus25.cortex-debug",
            "ms-vscode.cpptools",
            "ms-vscode.cmake-tools",
            "kilocode.kilo-code"
         ],
         "settings": {
            "C_Cpp.default.compileCommands": "${workspaceFolder}/build/debug/compile_commands.json",
            "C_Cpp.default.intelliSenseMode": "linux-gcc-arm",
            "cmake.configureOnOpen": false
         }
      }
   },
   "remoteUser": "root"
}